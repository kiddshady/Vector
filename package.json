{
  "name": "vector",
  "productName": "Vector",
  "version": "0.1.0",
  "description": "Vector — orquestador de agentes",
  "main": "main.cjs",
  "author": "Fran",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/engine.test.cjs && node test/editor.test.mjs && node test/store.test.mjs",
    "smoke": "electron test/renderer.test.cjs",
    "icon": "electron build/make-icon.cjs",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.umbrovex.vector",
    "productName": "Vector",
    "copyright": "Copyright © 2026 Umbrovex Systems",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!build/make-icon.cjs",
      "!data/**",
      "!test/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
